# ====================================
# RAQIM AI 966 - Environment Variables
# ====================================

# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/raqim_ai

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OAuth Configuration (Manus Platform)
OAUTH_SERVER_URL=https://oauth.manus.computer
VITE_APP_ID=your-app-id
OWNER_OPEN_ID=your-owner-open-id

# ====================================
# AI Provider API Keys
# ====================================

# DeepSeek API (Primary - Recommended for Arabic)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com

# OpenAI API (Alternative)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API (Alternative)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude API (Alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_API_BASE=https://api.anthropic.com

# Built-in Forge API (Manus Platform)
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ====================================
# LLM Provider Configuration
# ====================================

# Primary provider: "deepseek" | "openai" | "gemini" | "anthropic" | "forge"
LLM_PROVIDER=deepseek
DEFAULT_LLM_PROVIDER=deepseek

# ====================================
# Application Configuration
# ====================================

# Environment
NODE_ENV=development

# Server Port
PORT=3000

# App URL (for share links)
VITE_APP_URL=http://localhost:5173
